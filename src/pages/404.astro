---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — Page not found" description="The page you're looking for doesn't exist.">
  <Header />
  <main class="pt-32 pb-24">
    <div class="container-narrow text-center">
      <p class="font-display text-7xl md:text-9xl text-accent-300 leading-none">404</p>
      <h1 class="mt-6 heading-display text-3xl md:text-4xl tracking-tight">
        Page not found.
      </h1>
      <p class="mt-5 text-ink-300 text-lg max-w-md mx-auto">
        The link you followed is broken, or the post has been moved.
      </p>
      <div class="mt-10 flex items-center justify-center gap-3">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/blog" class="btn-ghost">Browse the blog</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
