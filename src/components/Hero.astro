---
const stats = [
  { label: 'Surfaces', value: '7+', sub: 'CLI · TUI · Desktop · Telegram · Discord · Slack · Web' },
  { label: 'Toolsets', value: '30+', sub: 'web, browser, code_exec, image, tts, memory, …' },
  { label: 'Skills', value: '80+', sub: 'bundled + user-created procedural memory' },
  { label: 'Providers', value: '20+', sub: 'OpenAI, Anthropic, Google, DeepSeek, xAI, local, …' },
];
---

<section class="relative isolate overflow-hidden pt-32 pb-24 md:pt-44 md:pb-32">
  <div class="absolute inset-0 -z-10 grid-bg"></div>
  <div class="absolute inset-0 -z-10 bg-grid-fade"></div>

  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center animate-fade-up">
      <span class="pill mb-6">
        <span class="pill-dot"></span>
        Updated · July 2026
      </span>

      <h1 class="heading-display text-5xl md:text-7xl leading-[1.05] tracking-tight">
        Hermes Agent is the
        <span class="font-display italic text-accent-300">broader</span>,
        sharper toolchain
        <br class="hidden md:block" />
        for builders who'd rather not settle.
      </h1>

      <p class="mt-8 text-lg md:text-xl text-ink-300 text-pretty max-w-2xl mx-auto leading-relaxed">
        Hermes and OpenClaw share DNA — both are local-first AI agents. Hermes
        extends the foundation with multi-surface parity, a curated skill
        ecosystem, first-class MCP, and a gateway that turns your agent into a
        cross-platform team member.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#comparison" class="btn-primary">
          See the side-by-side
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M5 12h14m-6-6 6 6-6 6"/>
          </svg>
        </a>
        <a href="https://hermes-agent.nousresearch.com/docs" target="_blank" rel="noopener" class="btn-ghost">
          Read the docs
        </a>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 animate-fade-up [animation-delay:200ms]">
      {stats.map((s) => (
        <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5 backdrop-blur">
          <div class="text-3xl md:text-4xl font-display tracking-tight text-white">{s.value}</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-ink-400">{s.label}</div>
          <div class="mt-3 text-xs text-ink-500 leading-relaxed">{s.sub}</div>
        </div>
      ))}
    </div>

    <!-- Floating preview chip -->
    <div class="mt-16 max-w-3xl mx-auto animate-fade-up [animation-delay:400ms]">
      <div class="rounded-xl border border-white/[0.08] bg-ink-950/80 shadow-glow-accent backdrop-blur-xl overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/[0.06] bg-white/[0.02]">
          <span class="flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-ink-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-ink-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-ink-700"></span>
          </span>
          <span class="ml-2 text-[11px] font-mono text-ink-500">~/projects · bash</span>
        </div>
        <div class="font-mono text-[13px] leading-7 p-5 text-ink-200">
          <div><span class="text-ink-500">$</span> <span class="text-accent-300">hermes</span> <span class="text-ink-300">chat -q</span> <span class="text-ink-400">"compare Hermes vs OpenClaw and write the summary"</span></div>
          <div class="text-ink-500 mt-2">→ routing to Nous Portal · 4 skills loaded · 3 sub-agents spawned</div>
          <div class="text-signal-green mt-1">✓ comparison.md written to ~/projects/hermes-vs-openclaw/comparison.md</div>
        </div>
      </div>
    </div>
  </div>
</section>
