---
const stories = [
  {
    role: 'Indie developer',
    name: 'J.',
    quote:
      "I run Hermes on a $200 Android tablet as my always-on assistant. The Telegram bot wakes up faster than my laptop. I've scripted it to push to GitHub and reply on Slack — same agent, both contexts, zero context switching.",
    stack: ['Termux', 'Telegram', 'GitHub'],
  },
  {
    role: 'Backend team lead',
    name: 'A.',
    quote:
      'Kanban mode lets us dispatch tickets to isolated workers per repo. The dispatcher reclaims stale claims and the gateway keeps the whole thing up. We removed two internal cron services by replacing them with hermes cron jobs.',
    stack: ['Kanban', 'Cron', 'GitHub MCP'],
  },
  {
    role: 'Researcher',
    name: 'M.',
    quote:
      'I scrape arXiv daily via a cron job, route summaries through Hermes with the academic skill loaded, and wake up to a curated digest in my Telegram. The skill auto-saves the patterns that worked — gets sharper every week.',
    stack: ['Cron', 'arxiv skill', 'TTS digest'],
  },
];
---

<section id="stories" class="relative py-24 md:py-32 border-t border-white/[0.06]">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <p class="eyebrow mb-4">In the wild</p>
      <h2 class="heading-display text-4xl md:text-5xl tracking-tight">
        What people actually build with it.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {stories.map((s) => (
        <figure class="card-feature flex flex-col">
          <svg viewBox="0 0 24 24" class="h-7 w-7 text-accent-400 mb-4" fill="currentColor">
            <path d="M9.5 7.5C9.5 5.57 11.07 4 13 4h2.5v4.5H13v2.5c0 2.76-2.24 5-5 5v-2.5c1.38 0 2.5-1.12 2.5-2.5v-3.5zm8 0C17.5 5.57 19.07 4 21 4h.5v4.5H21v2.5c0 2.76-2.24 5-5 5v-2.5c1.38 0 2.5-1.12 2.5-2.5v-3.5z"/>
          </svg>
          <blockquote class="text-base text-ink-200 leading-relaxed text-pretty flex-1">
            {s.quote}
          </blockquote>
          <figcaption class="mt-6 pt-5 border-t border-white/[0.06]">
            <div class="text-sm font-medium text-white">{s.name}, <span class="text-ink-400">{s.role}</span></div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {s.stack.map((t) => (
                <span class="font-mono text-[11px] text-ink-400">{t}</span>
              ))}
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
