---
const links = [
  { href: '#comparison', label: 'Compare' },
  { href: '#features', label: 'Features' },
  { href: '#architecture', label: 'Architecture' },
  { href: '#stories', label: 'Stories' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#faq', label: 'FAQ' },
  { href: '/blog', label: 'Blog' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-ink-1000/70 backdrop-blur-xl"
>
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <span
        class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-accent-500 to-accent-300 text-ink-1000 shadow-glow-accent"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M3 12h4l3-9 4 18 3-9h4" />
        </svg>
      </span>
      <span class="text-sm font-semibold tracking-tight text-white">
        Hermes<span class="text-ink-400">vs</span>OpenClaw
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm text-ink-300">
      {links.slice(0, 6).map((l) => (
        <a
          href={l.href}
          class="transition-colors hover:text-white"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="https://github.com/NousResearch/hermes-agent" target="_blank" rel="noopener" class="btn-ghost text-xs">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
          <path d="M12 .3a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.31-.54-1.54.11-3.2 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.89.12 3.2.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3" />
        </svg>
        <span class="hidden sm:inline">Star on GitHub</span>
      </a>
      <a href="#pricing" class="btn-primary text-xs">
        Get started
      </a>
    </div>
  </div>
</header>
