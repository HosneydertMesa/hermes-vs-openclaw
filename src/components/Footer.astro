---
const cols = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#features' },
      { label: 'Pricing', href: '#pricing' },
      { label: 'Changelog', href: 'https://github.com/NousResearch/hermes-agent/releases' },
      { label: 'Roadmap', href: 'https://github.com/NousResearch/hermes-agent/issues' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Documentation', href: 'https://hermes-agent.nousresearch.com/docs' },
      { label: 'GitHub', href: 'https://github.com/NousResearch/hermes-agent' },
      { label: 'Discord', href: 'https://discord.gg/NousResearch' },
      { label: 'Portal', href: 'https://portal.nousresearch.com' },
    ],
  },
  {
    title: 'Compare',
    links: [
      { label: 'vs OpenClaw', href: '#comparison' },
      { label: 'vs Claude Code', href: '#' },
      { label: 'vs Codex CLI', href: '#' },
      { label: 'vs LangChain', href: '#' },
    ],
  },
];
const base = import.meta.env.BASE_URL;
---


<footer class="relative border-t border-white/[0.06] py-16 md:py-20">
  <div class="container-page">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <a href={`${base}`} class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-accent-500 to-accent-300 text-ink-1000">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M3 12h4l3-9 4 18 3-9h4"/>
            </svg>
          </span>
          <span class="text-base font-semibold text-white">Hermes<span class="text-ink-400">vs</span>OpenClaw</span>
        </a>
        <p class="mt-5 text-sm text-ink-300 leading-relaxed max-w-md">
          A side-by-side built by the community. We built this page using Hermes itself, on a $200 Android tablet, on Termux, in about an hour.
        </p>
        <p class="mt-6 text-xs font-mono text-ink-500">
          Built with Astro · Tailwind · deployed from Termux via Hermes Agent
        </p>
      </div>

      <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8">
        {cols.map((col) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-white">{col.title}</h3>
            <ul class="mt-4 space-y-3 text-sm">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-ink-400 hover:text-white transition-colors">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/[0.06] flex flex-wrap items-center justify-between gap-4 text-xs text-ink-500">
      <div>© 2026 Hermes-vs-OpenClaw · MIT · not affiliated with Nous Research</div>
      <div class="flex items-center gap-5">
        <a href="https://github.com/NousResearch/hermes-agent" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a>
        <a href="https://hermes-agent.nousresearch.com/docs" target="_blank" rel="noopener" class="hover:text-white transition-colors">Docs</a>
        <a href="https://portal.nousresearch.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">Portal</a>
      </div>
    </div>
  </div>
</footer>
