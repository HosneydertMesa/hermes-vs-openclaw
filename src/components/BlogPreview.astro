---
const posts = [
  {
    title: 'Hermes on a $200 Android tablet: a five-day field report',
    excerpt: 'Wake-lock, watchdog, Telegram bot, GitHub auth, and the lessons learned from running a full agent runtime on hardware that fits in a coat pocket.',
    tag: 'Field report',
    date: '2026-07-30',
    slug: 'termux-field-report',
    readMin: 7,
  },
  {
    title: 'Why Cortex-A55 breaks modern Chromium (and what to do)',
    excerpt: 'ARMv8-A vs ARMv8.2-A: why your CPU silently refuses to run modern Chrome, and the realistic paths to browser automation on legacy hardware.',
    tag: 'Engineering',
    date: '2026-07-29',
    slug: 'cortex-a55-chromium',
    readMin: 9,
  },
  {
    title: 'The Tool Gateway economics, explained',
    excerpt: 'Why bundling web + image + TTS + browser under one Portal subscription beats stitching five separate API keys — even for power users.',
    tag: 'Architecture',
    date: '2026-07-25',
    slug: 'tool-gateway-economics',
    readMin: 6,
  },
];
---

<section id="blog" class="relative py-24 md:py-32 border-t border-white/[0.06]">
  <div class="container-page">
    <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
      <div>
        <p class="eyebrow mb-3">From the blog</p>
        <h2 class="heading-display text-4xl md:text-5xl tracking-tight">Field notes</h2>
      </div>
      <a href="/blog" class="btn-ghost text-xs">
        All posts
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 12h14m-6-6 6 6-6 6"/>
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="card-feature group block">
          <div class="flex items-center justify-between text-[11px] font-mono text-ink-400 mb-4">
            <span class="rounded-md bg-white/[0.05] px-2 py-0.5 ring-1 ring-inset ring-white/[0.06]">{p.tag}</span>
            <span>{new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} · {p.readMin} min</span>
          </div>
          <h3 class="text-base font-medium text-white text-pretty leading-snug">{p.title}</h3>
          <p class="mt-3 text-sm text-ink-300 leading-relaxed">{p.excerpt}</p>
          <div class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent-300 group-hover:text-accent-200">
            Read more
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M5 12h14m-6-6 6 6-6 6"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
